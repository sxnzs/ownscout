#!/usr/bin/env bash
# The one command that decides whether work is done. Runs locally and in CI.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ran=0
run() { echo "==> $*"; "$@"; ran=1; }

if [ -f Cargo.toml ]; then
  run cargo fmt --all --check
  run cargo clippy --all-targets -- -D warnings
  run cargo test
  run cargo build --release
fi

if [ -d spec/parity ]; then
  export PYTHONDONTWRITEBYTECODE=1
  run python3 -m unittest discover -s spec/parity -p '*test*.py'
  run python3 spec/parity/harness.py --bin target/release/ownscout
  run python3 spec/parity/harness.py --corpus spec/parity/corpus-edge.json --bin target/release/ownscout
fi

if [ "$ran" -eq 0 ]; then
  echo "verify: no stack detected, so nothing was checked" >&2
  exit 1
fi
echo "verify: ok"
